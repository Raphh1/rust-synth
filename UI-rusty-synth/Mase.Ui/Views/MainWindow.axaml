<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mase.Ui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Mase.Ui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Mase.Ui">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto">

     <Border Grid.Row="0" Background="#2D2D30" Padding="10" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Open Piano Roll" Command="{Binding OpenPianoRollCommand}" Background="#007ACC" Foreground="White"/>
                <Separator Background="#555" Width="1" Margin="5,0"/>
                <Button Content="Play" Background="#3E3E42" Foreground="LightGreen"/>
                <Button Content="Stop" Background="#3E3E42" Foreground="Red"/>
            </StackPanel>
        </Border>

        <!-- CENTER: Patch Editor Area -->
        <Border Grid.Row="1" Background="#1E1E1E">
            <TextBlock Text="Main Patch Area (Rack / Modules)" 
                       Foreground="#666" 
                       FontSize="24"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </Border>

        <!-- BOTTOM: Status Bar -->
        <Border Grid.Row="2" Background="#007ACC" Padding="5,2">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="12"/>
        </Border>

    </Grid>

</Window>
